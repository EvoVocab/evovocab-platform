{
  "name": "@evovocab/repo",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "EvoVocab",
  "description": "Evocab là một nền tảng cá nhân hóa việc từ vựng tiếng Anh, giúp người dùng nâng cao vốn từ vựng một cách hiệu quả và thú vị.",
  "repository": {
    "type": "git",
    "url": "https://github.com/EvoVocab/evovocab-platform.git"
  },
  "scripts": {
    "setup": "npm i & shx cp apps/web/.env.example apps/web/.env & shx cp apps/api/.env.example apps/api/.env & shx cp docker-compose.example.yml docker-compose.yml",
    "setup:deploy": "bash ./scripts/setup_deploy.sh",
    "api:docker:up": "docker compose -f docker-compose.yml up -d --build",
    "api:docker:down": "docker compose -f docker-compose.yml down",
    "typecheck": "nx run-many --target=typecheck --all",
    "analyst": "knip --no-config-hints",
    "prepare": "husky"
  },
  "private": true,
  "devDependencies": {
