{
  "name": "@evovocab/shared-api",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/api/src",
  "targets": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "libs/shared/api/dist",
        "main": "libs/shared/api/src/index.ts",
        "tsConfig": "libs/shared/api/tsconfig.lib.json",
        "skipTypeCheck": true,
        "stripLeadingPaths": true
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["@evovocab/api"],
          "target": "generate-openapi"
        }
      ],
      "options": {
        "command": "openapi-generator-cli generate -i apps/api/docs/swagger.json -g typescript-axios -o libs/shared/api/src/lib --ignore-file-override libs/shared/api/.openapi-generator-ignore"
      }
    }
  }
}
