{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-java", "prettier-plugin-tailwindcss"],
  "overrides": [
    {
      "files": ["*.java"],
      "options": {
        "tabWidth": 4,
        "printWidth": 120,
        "singleQuote": false,
        "trailingComma": "none"
      }
    },
    {
      "files": ["*.xml", "pom.xml"],
      "options": {
        "tabWidth": 4,
        "printWidth": 120
      }
    },
    {
      "files": ["*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2,
        "singleQuote": false
      }
    }
  ]
}
